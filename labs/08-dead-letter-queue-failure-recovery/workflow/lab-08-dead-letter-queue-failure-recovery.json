      ],
      "id": "7ec3bb1f-7f29-4402-8d60-8bc1f220fc44",
      "name": "Prepare Processing Attempt"
    },
    {
      "parameters": {
        "jsCode": "const scenario = $json.scenario;\nconst attempt = $json.attempt;\nconst successOnAttempt = $json.success_on_attempt;\n\nlet success = false;\nlet statusCode;\nlet errorMessage = null;\n\nif (scenario === 'permanent_failure') {\n  statusCode = 503;\n  errorMessage = 'Downstream service unavailable';\n} else if (scenario === 'eventual_success') {\n  if (attempt >= successOnAttempt) {\n    success = true;\n    statusCode = 200;\n  } else {\n    statusCode = 503;\n    errorMessage = 'Temporary downstream failure';\n  }\n} else {\n  success = true;\n  statusCode = 200;\n}\n\nreturn {\n  json: {\n    ...$json,\n    processing_result: {\n      success,\n      status_code: statusCode,\n      error_message: errorMessage\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
