      "id": "f8ad9e9f-b360-4db6-be2d-193791a34cb6",
      "name": "Fetch First Customer Page"
    },
    {
      "parameters": {
        "jsCode": "const total = $json.total;\nconst skip = $json.skip;\nconst limit = $json.limit;\n\nconst nextSkip = skip + limit;\nconst hasMore = nextSkip < total;\n\nreturn {\n  json: {\n    total,\n    current_skip: skip,\n    limit,\n    next_skip: nextSkip,\n    has_more: hasMore\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -48
      ],
      "id": "a02e0fc3-38c0-4f3f-8a0c-099ee3695991",
      "name": "Read Pagination Info"
    },
    {
      "parameters": {
        "url": "https://dummyjson.com/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "={{ $json.limit }}"
            },
            {
              "name": "skip",
              "value": "={{ $json.next_skip }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        432,
        -48
      ],
      "id": "c92d4266-960e-4e4d-9704-53076e0867ce",
      "name": "Fetch Next Customer Page"
    },
    {
      "parameters": {
        "url": "https://dummyjson.com/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "=7"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "skip",
                    "value": "={{ $pageCount * 5 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.skip + $response.body.limit >= $response.body.total }}"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        0,
        160
      ],
      "id": "d5648aa0-006a-41e4-9167-8b662e8a5a51",
      "name": "Fetch All Customer Pages"
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\n\nconst customers = pages.flatMap(page => {\n  return page.json.users ?? [];\n});\n\nreturn [\n  {\n    json: {\n      pages_fetched: pages.length,\n      total_records: customers.length,\n      customers\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        160
      ],
      "id": "91f9177b-a7d4-4edc-92bf-6c2e22410605",
      "name": "Combine Customer Records"
    },
    {
      "parameters": {
        "jsCode": "const customers = $json.customers ?? [];\n\nreturn customers.map(customer => ({\n  json: {\n    customer_id: customer.id,\n    full_name: `${customer.firstName} ${customer.lastName}`,\n    company: customer.company?.name ?? '',\n    email: customer.email,\n    phone: customer.phone\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        160
      ],
      "id": "ace2d9be-8850-4525-a97b-b51d2a0cb49f",
      "name": "Prepare Customers for Processing"
    }
