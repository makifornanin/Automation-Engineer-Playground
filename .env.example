# AEP environment variables
#
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit real keys.
#
# Note: the labs themselves do NOT read these at runtime.
# n8n stores connection details in its own credential store
# (see docs/environment-setup.md). Keep these here only as a
# local reference for the Supabase project you connected n8n to.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=

# Supabase service role key. Treat as a password - it bypasses
# row level security. Never paste it into a workflow or a lab file.
SUPABASE_SECRET_KEY=
