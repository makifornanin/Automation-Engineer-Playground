# AEP Website environment variables
# Copy to `web/.env.local` (git-ignored). Never commit real values.
#
# RULE: NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# Anything with that prefix is PUBLIC and permanent. Never use it for a
# Supabase service-role key, an n8n API key, or any other secret.

# Public site origin. Safe to expose.
#
# Also controls the auth session cookie's Secure flag (cookie-options.ts):
# Secure is set only when this starts with "https://". Local dev is
# deliberately http://localhost, where a Secure cookie would silently never
# be sent, so keep this in sync with the real deployed origin/protocol.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon (public) key. Both are safe to expose — the
# anon key is designed to be public and relies on Supabase's own row-level
# security, not secrecy. Missing or empty values make the app run fully
# signed-out rather than fail to build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...): name only, deliberately no value line
# here. Server-only: read by src/lib/supabase/admin-client.ts for the Admin
# page (invite, list, revoke). It bypasses row-level security, so NEVER prefix
# it with NEXT_PUBLIC_ and never commit a real value.
# SUPABASE_SECRET_KEY=

# Kaz V2 (names only, server-only - see web/.env.example):
# KAZ_GATEWAY_URL, KAZ_GATEWAY_SECRET, KAZ_N8N_HOST

# --------------------------------------------------------------------- Kaz
# Kaz V2 talks to one dedicated n8n workflow (the Kaz Gateway), which reads
# workflow and execution context and calls Gemini. All three are SERVER-ONLY:
# never prefix them with NEXT_PUBLIC_, and never commit real values.
#
# The Gateway's production webhook URL.
KAZ_GATEWAY_URL=
# Shared secret, sent as the x-aep-kaz-secret header. The same value is stored
# in n8n as a Header Auth credential on the Gateway's webhook node, so the
# workflow export carries a credential reference instead of a secret.
KAZ_GATEWAY_SECRET=
# Hostname of the n8n the Gateway can read. A learner whose saved webhook is on
# any other host is told honestly that Kaz cannot inspect it.
KAZ_N8N_HOST=
